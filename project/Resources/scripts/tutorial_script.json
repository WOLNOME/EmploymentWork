{
  "tutorial_intro": [
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "OpenMessageWindow" }
      ],
      "wait": "MessageWindowOpened"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "訓練場へようこそ！ここで実戦の練習を積んでいきましょう！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "訓練を終了したい場合は\nポーズメニューからスキップできます" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "CloseMessageWindow" }
      ],
      "wait": "MessageWindowClosed"
    }
  ],

  "tutorial_move": [
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "OpenMessageWindow" },
        {
          "cmd": "FixPlayer",
          "pos": [0, 0, -200],
          "rot": [0, 0, 0]
        }
      ],
      "wait": "MessageWindowOpened"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "移動の訓練です" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        {
          "cmd": "SpawnItem",
          "type": "Item",
          "count": 1,
          "transforms": [
            { "pos": [0, 0, 5] }
          ]
        },
        { "cmd": "ShowMessage", "text": "前方のアイテムをとってみましょう" },
        { "cmd": "MoveCameraToTarget","pos": [0, 4.5, -15],"rot": [0, 0, 0],"moveTime":1.5,"stillnessTime":1.5}
      ],
      "wait": "CameraFinished"
    },
    {
      "cmds": [
        { "cmd": "UnlockInput" },
        {
          "cmd": "FixPlayer",
          "pos": [0, 0, -200],
          "rot": [0, 0, 0]
        },
        { "cmd": "ShowMessage", "text": "Lスティック：移動\nRスティック：カメラ操作" },
        { "cmd": "SetObjective","type": "collectItem",  "count": 1 }
      ],
      "wait": "ObjectiveComplete"
    },
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "ShowMessage", "text": "ナイス！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        {
          "cmd": "SpawnItem",
          "type": "Item",
          "count": 5,
          "transforms": [
            { "pos": [20, 0, 160] },
            { "pos": [-150, 0, 40] },
            { "pos": [-100, 0, -175] },
            { "pos": [65, 0, -105] },
            { "pos": [180, 0, 25] }
          ]
        },
        { "cmd": "ShowMessage", "text": "次はもっと多くのアイテムをとってみましょう" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "UnlockInput" },
        { "cmd": "ShowMessage", "text": "Lスティック：移動\nRスティック：カメラ操作" },
        { "cmd": "SetObjective","type": "collectItem", "count": 5 }
      ],
      "wait": "ObjectiveComplete"
    },
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "ShowMessage", "text": "お見事！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "実際の戦場でもこの訓練を思い出して駆けまわってみてくださいね" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "もう一度訓練を行いたい場合はポーズメニューからできます" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "CloseMessageWindow" }
      ],
      "wait": "MessageWindowClosed"
    }
  ],

  "tutorial_attack": [
  {
    "cmds": [
      { "cmd": "LockInput" },
      { "cmd": "OpenMessageWindow" },
      {
        "cmd": "FixPlayer",
        "pos": [0, 0, -200],
        "rot": [0, 0, 0]
      }
    ],
    "wait": "MessageWindowOpened"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "攻撃の訓練です" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "まずは動かない敵に攻撃を当ててみましょう" },
      {
        "cmd": "SpawnEnemy",
        "type": "Canota",
        "pos": [0, 0, 0],
        "rot": [0, 3.14, 0]
      },
      { "cmd": "EnemyActive", "active": 0 },
      { "cmd": "EnemyInvicible", "invicible": 1 }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "UnlockInput" },
      { "cmd": "ShowMessage", "text": "LT：砲弾攻撃\nRT：機関銃攻撃" },
      { "cmd": "SetObjective", "type": "hitCannon", "count": 3 },
      { "cmd": "SetObjective", "type": "hitBullet", "count": 30 }
    ],
    "wait": "ObjectiveComplete"
  },
  {
    "cmds": [
      { "cmd": "LockInput" },
      { "cmd": "ClearEnemy" },
      {
        "cmd": "SpawnItem",
        "type": "Special",
        "count": 1,
        "transforms": [
          { "pos": [0, 0, 0] }
        ]
      },
      { "cmd": "ShowMessage", "text": "青戦車を倒すと\n回復アイテムやスペシャル弾をドロップすることがあります" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "UnlockInput" },
      { "cmd": "ShowMessage", "text": "敵が落としたスペシャル弾を拾ってみましょう！" },
      {
        "cmd": "SetObjective",
        "type": "collectSpecial",
        "count": 1
      }
    ],
    "wait": "ObjectiveComplete"
  },
  {
    "cmds": [
      { "cmd": "LockInput" },
      { "cmd": "ShowMessage", "text": "Bでスペシャル弾を撃つことができます\n敵やバリアに当てると特大ダメージが入りますが\n青戦車のドロップでしか手に入らないので慎重に使いましょう！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      {
        "cmd": "FixPlayer",
        "pos": [0, 0, -200],
        "rot": [0, 0, 0]
      },
      {
        "cmd": "SpawnEnemy",
        "type": "KeyCanota",
        "pos": [0, 0, 0],
        "rot": [0, 3.14, 0]
      },
      { "cmd": "EnemyActive", "active": 0 },
      { "cmd": "EnemyInvicible", "invicible": 0 },
      { "cmd": "ShowMessage", "text": "次は動く敵と戦ってみましょう！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "スペシャル弾を当てると楽に倒すことができるので狙ってみてください！\n（※Aで戦闘が開始されます）" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "EnemyActive", "active": 1 },
      { "cmd": "UnlockInput" },
      { "cmd": "ShowMessage", "text": "LT：砲弾攻撃\nRT：機関銃攻撃\nB：スペシャルアタック" },
      {
        "cmd": "SetObjective",
        "type": "defeatEnemy"
      }
    ],
    "wait": "ObjectiveComplete"
  },
  {
    "cmds": [
      { "cmd": "LockInput" },
      { "cmd": "ShowMessage", "text": "お見事！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "この調子でたくさん戦果を挙げてみてくださいね！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "もう一度訓練を行いたい場合はポーズメニューからできます\n（※このメッセージを終了した場合チュートリアルを終了します）" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "CloseMessageWindow" }
    ],
    "wait": "MessageWindowClosed"
  }
]
}
