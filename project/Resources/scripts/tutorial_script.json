{
  "tutorial_intro": [
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "PlayerInvicible", "invicible": 1 },
        { "cmd": "OpenMessageWindow" }
      ],
      "wait": "MessageWindowOpened"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "訓練場へようこそ！ここで実戦の練習を積んでいきましょう！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "訓練を終了したい場合はポーズメニューからスキップできます" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "CloseMessageWindow" }
      ],
      "wait": "MessageWindowClosed"
    }
  ],

  "tutorial_move": [
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "OpenMessageWindow" },
        {
          "cmd": "FixPlayer",
          "pos": [0, 0, -200],
          "rot": [0, 0, 0]
        }
      ],
      "wait": "MessageWindowOpened"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "移動の訓練です" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        {
          "cmd": "SpawnItem",
          "type": "Item",
          "count": 1,
          "transforms": [
            { "pos": [0, 0, 5] }
          ]
        },
        { "cmd": "ShowMessage", "text": "前方のアイテムをとってみましょう" },
        { "cmd": "MoveCameraToTarget","pos": [0, 4.5, -15],"rot": [0, 0, 0],"moveTime":1.5,"stillnessTime":1.5}
      ],
      "wait": "CameraFinished"
    },
    {
      "cmds": [
        { "cmd": "UnlockInput" },
        {
          "cmd": "FixPlayer",
          "pos": [0, 0, -200],
          "rot": [0, 0, 0]
        },
        { "cmd": "ShowMessage", "text": "Lスティック：移動\nRスティック：カメラ" },
        { "cmd": "SetObjective","type": "collectItem",  "count": 1 }
      ],
      "wait": "ObjectiveComplete"
    },
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "ShowMessage", "text": "ナイス！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        {
          "cmd": "SpawnItem",
          "type": "Item",
          "count": 5,
          "transforms": [
            { "pos": [20, 0, 160] },
            { "pos": [-150, 0, 40] },
            { "pos": [-100, 0, -175] },
            { "pos": [65, 0, -105] },
            { "pos": [180, 0, 25] }
          ]
        },
        { "cmd": "ShowMessage", "text": "次はもっとたくさんのアイテムをとってみましょう" }
      ],
      "wait": "MessageTextFinished"
    },
    {
    "cmds": [
      { "cmd": "ShowMessage", "text": "アイテムの場所が分からない時は\n画面下のレーダーで確認できます" }
    ],
    "wait": "MessageTextFinished"
    },
    {
    "cmds": [
      { "cmd": "ShowMessage", "text": "他にも敵の位置を映してくれたり\n矢印で作戦の進行をサポートしてくれる優れモノです！" }
    ],
    "wait": "MessageTextFinished"
    },
    {
    "cmds": [
      { "cmd": "ShowMessage", "text": "レーダーを活かして戦場を優位に立ちまわってみてください！\n（※Aでミッション開始）" }
    ],
    "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "UnlockInput" },
        { "cmd": "ShowMessage", "text": "Lスティック：移動\nRスティック：カメラ" },
        { "cmd": "SetObjective","type": "collectItem", "count": 5 }
      ],
      "wait": "ObjectiveComplete"
    },
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "ShowMessage", "text": "お見事！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "実際の戦場でも今のように駆けまわってみてくださいね！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "CloseMessageWindow" }
      ],
      "wait": "MessageWindowClosed"
    }
  ],

  "tutorial_attack": [
  {
    "cmds": [
      { "cmd": "LockInput" },
      { "cmd": "OpenMessageWindow" },
      {
        "cmd": "FixPlayer",
        "pos": [0, 0, -200],
        "rot": [0, 0, 0]
      }
    ],
    "wait": "MessageWindowOpened"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "攻撃の訓練です" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "まずは動かない敵に攻撃を当ててみましょう" },
      {
        "cmd": "SpawnEnemy",
        "type": "Canota",
        "pos": [0, 0, 0],
        "rot": [0, 3.14, 0]
      },
      { "cmd": "EnemyActive", "active": 0 },
      { "cmd": "EnemyInvicible", "invicible": 1 }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "砲弾は1発、機関銃弾は50発撃ちきると\nリロードが発生するので注意してください" }
    ],
    "wait": "MessageTextFinished"
    },
  {
    "cmds": [
      { "cmd": "UnlockInput" },
      { "cmd": "ShowMessage", "text": "LT：砲弾攻撃\nRT：機関銃攻撃" },
      { "cmd": "SetObjective", "type": "hitCannon", "count": 3 },
      { "cmd": "SetObjective", "type": "hitBullet", "count": 30 }
    ],
    "wait": "ObjectiveComplete"
  },
  {
    "cmds": [
      { "cmd": "LockInput" },
      { "cmd": "ClearEnemy" },
      {
        "cmd": "SpawnItem",
        "type": "Special",
        "count": 1,
        "transforms": [
          { "pos": [0, 0, 0] }
        ]
      },
      { "cmd": "ShowMessage", "text": "青戦車を倒すと回復アイテムやスペシャル弾を\nドロップすることがあります" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "また、画面右下の[HP]が0になると作戦失敗となるので\n体力が減ってきたら回復アイテムで回復しましょう！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "ちなみにアイテムは取得するまで消えることはないので\n必要になったら取りに戻るといいですよ！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "UnlockInput" },
      { "cmd": "ShowMessage", "text": "それでは敵が落としたスペシャル弾を拾ってみましょう！" },
      {
        "cmd": "SetObjective",
        "type": "collectSpecial",
        "count": 1
      }
    ],
    "wait": "ObjectiveComplete"
  },
  {
    "cmds": [
      { "cmd": "LockInput" },
      { "cmd": "ShowMessage", "text": "画面左下の[SPECIAL]に雷マークがひとつ点きましたね！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "Bボタンでこの雷マークを一つ消費して\nスペシャル弾を撃つことができます" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "敵やボスの展開するバリアに当てて特大ダメージを狙いましょう！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "ただし青戦車からのドロップでしか手に入らないので\nここぞという時に使ってみてください！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      {
        "cmd": "FixPlayer",
        "pos": [0, 0, -200],
        "rot": [0, 0, 0]
      },
      {
        "cmd": "SpawnEnemy",
        "type": "KeyCanota",
        "pos": [0, 0, 0],
        "rot": [0, 3.14, 0]
      },
      { "cmd": "EnemyActive", "active": 0 },
      { "cmd": "EnemyInvicible", "invicible": 0 },
      { "cmd": "ShowMessage", "text": "次は動く敵と戦ってみましょう！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "敵の砲身の向きに注意して攻撃を避けましょう！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "また、敵の砲弾に攻撃を当てると撃ち落とすことが\nできるので狙ってみてください！\n（※Aで戦闘が開始されます）" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "EnemyActive", "active": 1 },
      { "cmd": "UnlockInput" },
      { "cmd": "ShowMessage", "text": "LT：砲弾攻撃\nRT：機関銃攻撃\nB：スペシャルアタック" },
      {
        "cmd": "SetObjective",
        "type": "defeatEnemy"
      }
    ],
    "wait": "ObjectiveComplete"
  },
  {
    "cmds": [
      { "cmd": "LockInput" },
      { "cmd": "ShowMessage", "text": "お見事！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "この調子でたくさん戦果を挙げてみてくださいね！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "ちなみに紫戦車が落とした鍵は2つ揃えると\nボスの封印を解くことができます" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "この訓練を思い出して本作戦の破壊目標である\nボスを撃破しましょう！" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "ShowMessage", "text": "もう一度訓練を行いたい場合はポーズメニューからできます\n（※このメッセージを終了した場合チュートリアルを終了します）" }
    ],
    "wait": "MessageTextFinished"
  },
  {
    "cmds": [
      { "cmd": "CloseMessageWindow" }
    ],
    "wait": "MessageWindowClosed"
  }
]
}
