{
  "tutorial_intro": [
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "OpenMessageWindow" }
      ],
      "wait": "MessageWindowOpened"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "訓練場へようこそ！ここで実戦の練習を積んでいきましょう！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "CloseMessageWindow" }
      ],
      "wait": "MessageWindowClosed"
    }
  ],

  "tutorial_move": [
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "OpenMessageWindow" },
        {
          "cmd": "FixPlayer",
          "pos": [0, 0, -200],
          "rot": [0, 0, 0]
        }
      ],
      "wait": "MessageWindowOpened"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "移動の訓練です" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        {
          "cmd": "SpawnItem",
          "count": 1,
          "transforms": [
            { "pos": [0, 0, 5] }
          ]
        },
        { "cmd": "ShowMessage", "text": "前方のアイテムをとってみましょう" },
        { "cmd": "MoveCameraToTarget","pos": [0, 5, -10],"rot": [0, 0, 0]}
      ],
      "wait": "CameraFinished"
    },
    {
      "cmds": [
        { "cmd": "ShowMoveTutorialSprite" }
      ],
      "wait": "SpriteFinished"
    },
    {
      "cmds": [
        { "cmd": "UnlockInput" },
        {
          "cmd": "FixPlayer",
          "pos": [0, 0, -200],
          "rot": [0, 0, 0]
        },
        { "cmd": "ShowMessage", "text": "Lスティック：移動\nRスティック：カメラ操作" },
        { "cmd": "SetObjective","type": "collect",  "count": 1 }
      ],
      "wait": "ObjectiveComplete"
    },
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "ShowMessage", "text": "ナイス！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        {
          "cmd": "SpawnItem",
          "count": 5,
          "transforms": [
            { "pos": [20, 0, 160] },
            { "pos": [-150, 0, 40] },
            { "pos": [-100, 0, -175] },
            { "pos": [65, 0, -105] },
            { "pos": [180, 0, 25] }
          ]
        },
        { "cmd": "ShowMessage", "text": "次はもっと多くのアイテムをとってみましょう" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "UnlockInput" },
        { "cmd": "ShowMessage", "text": "Lスティック：移動\nRスティック：カメラ操作" },
        { "cmd": "SetObjective","type": "collect", "text": "アイテムを取得", "count": 5 }
      ],
      "wait": "ObjectiveComplete"
    },
    {
      "cmds": [
        { "cmd": "LockInput" },
        { "cmd": "ShowMessage", "text": "お見事！" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "実際の戦場でもこの訓練を思い出して駆けまわってみてくださいね" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "ShowMessage", "text": "もう一度訓練を行いたい場合はポーズメニューからできます" }
      ],
      "wait": "MessageTextFinished"
    },
    {
      "cmds": [
        { "cmd": "CloseMessageWindow" }
      ],
      "wait": "MessageWindowClosed"
    }
  ]
}
